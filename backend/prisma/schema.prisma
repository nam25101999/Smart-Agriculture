datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. IDENTITY & RBAC
// ==========================================

model User {
  id            String         @id @default(uuid()) @db.Uuid
  email         String         @unique @db.VarChar(150)
  passwordHash  String         @map("password_hash") @db.VarChar(255)
  fullName      String         @map("full_name") @db.VarChar(150)
  phone         String?        @db.VarChar(20)
  status        String         @default("ACTIVE") @db.VarChar(20) // ACTIVE, INACTIVE, SUSPENDED
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt     DateTime?      @map("deleted_at") @db.Timestamptz()

  userRoles       UserRole[]
  ownedFarms      Farm[]          @relation("FarmOwner")
  farmMemberships FarmMember[]
  refreshTokens   RefreshToken[]
  deviceCommands  DeviceCommand[] @relation("CommandRequester")
  notifications   Notification[]
  deviceTokens    DeviceToken[]
  auditLogs       AuditLog[]

  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(50) // SUPER_ADMIN, FARM_OWNER, FARM_MANAGER, TECHNICIAN, FARM_WORKER, VIEWER
  name        String   @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  userRoles       UserRole[]
  rolePermissions RolePermission[]
  farmMembers     FarmMember[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(100) // e.g., farms:create, devices:command, telemetry:read
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz()
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ==========================================
// 2. FARM & ZONE MANAGEMENT
// ==========================================

model Farm {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(150)
  code        String    @unique @db.VarChar(50)
  description String?   @db.Text
  location    String?   @db.Text
  latitude    Decimal?  @db.Decimal(10, 7)
  longitude   Decimal?  @db.Decimal(10, 7)
  ownerId     String    @map("owner_id") @db.Uuid
  status      String    @default("ACTIVE") @db.VarChar(20) // ACTIVE, INACTIVE
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz()

  owner           User             @relation("FarmOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members         FarmMember[]
  zones           Zone[]
  alertRules      AlertRule[]
  alerts          Alert[]
  automationRules AutomationRule[]

  @@index([ownerId])
  @@map("farms")
}

model FarmMember {
  id        String   @id @default(uuid()) @db.Uuid
  farmId    String   @map("farm_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([farmId, userId])
  @@index([userId])
  @@map("farm_members")
}

model Zone {
  id          String    @id @default(uuid()) @db.Uuid
  farmId      String    @map("farm_id") @db.Uuid
  name        String    @db.VarChar(100)
  description String?   @db.Text
  area        Decimal?  @db.Decimal(10, 2)
  status      String    @default("ACTIVE") @db.VarChar(20)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz()

  farm            Farm             @relation(fields: [farmId], references: [id], onDelete: Cascade)
  devices         Device[]
  alertRules      AlertRule[]
  alerts          Alert[]
  automationRules AutomationRule[]

  @@index([farmId])
  @@map("zones")
}

// ==========================================
// 3. IOT DEVICES & SENSORS
// ==========================================

model Device {
  id              String    @id @default(uuid()) @db.Uuid
  zoneId          String    @map("zone_id") @db.Uuid
  deviceCode      String    @unique @map("device_code") @db.VarChar(100) // e.g., ESP32_ZONE_01
  name            String    @db.VarChar(150)
  deviceType      String    @default("ESP32") @map("device_type") @db.VarChar(50)
  firmwareVersion String?   @map("firmware_version") @db.VarChar(50)
  mqttClientId    String?   @map("mqtt_client_id") @db.VarChar(100)
  status          String    @default("OFFLINE") @db.VarChar(30) // ONLINE, OFFLINE, MAINTENANCE
  lastSeenAt      DateTime? @map("last_seen_at") @db.Timestamptz()
  registeredAt    DateTime  @default(now()) @map("registered_at") @db.Timestamptz()
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  zone        Zone              @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  credentials DeviceCredential?
  sensors     Sensor[]
  telemetry   Telemetry[]
  commands    DeviceCommand[]
  alerts      Alert[]

  @@index([zoneId])
  @@map("devices")
}

model DeviceCredential {
  id             String    @id @default(uuid()) @db.Uuid
  deviceId       String    @unique @map("device_id") @db.Uuid
  credentialHash String    @map("credential_hash") @db.VarChar(255)
  isActive       Boolean   @default(true) @map("is_active")
  rotatedAt      DateTime? @map("rotated_at") @db.Timestamptz()
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("device_credentials")
}

model Sensor {
  id         String   @id @default(uuid()) @db.Uuid
  deviceId   String   @map("device_id") @db.Uuid
  sensorType String   @map("sensor_type") @db.VarChar(50) // DHT22, SOIL_MOISTURE, LIGHT, WATER_LEVEL
  metricName String   @map("metric_name") @db.VarChar(50) // temperature, humidity, soilMoisture...
  unit       String   @db.VarChar(30) // celsius, percent, lux...
  status     String   @default("ACTIVE") @db.VarChar(20)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  device    Device      @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  telemetry Telemetry[]

  @@index([deviceId])
  @@map("sensors")
}

// ==========================================
// 4. TELEMETRY DATA
// ==========================================

model Telemetry {
  id         String   @id @default(uuid()) @db.Uuid
  deviceId   String   @map("device_id") @db.Uuid
  sensorId   String?  @map("sensor_id") @db.Uuid
  messageId  String?  @map("message_id") @db.VarChar(100) // Idempotency check
  metric     String   @db.VarChar(50) // temperature, humidity, soilMoisture, etc.
  value      Decimal  @db.Decimal(12, 4)
  unit       String?  @db.VarChar(30)
  recordedAt DateTime @map("recorded_at") @db.Timestamptz()
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz()
  metadata   Json?    @db.JsonB

  device Device  @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  sensor Sensor? @relation(fields: [sensorId], references: [id], onDelete: SetNull)

  @@index([deviceId, recordedAt(sort: Desc)])
  @@index([sensorId, recordedAt(sort: Desc)])
  @@index([metric, recordedAt(sort: Desc)])
  @@map("telemetry")
}

// ==========================================
// 5. ALERT & AUTOMATION RULES
// ==========================================

model AlertRule {
  id              String   @id @default(uuid()) @db.Uuid
  farmId          String   @map("farm_id") @db.Uuid
  zoneId          String?  @map("zone_id") @db.Uuid
  name            String   @db.VarChar(100)
  metric          String   @db.VarChar(50) // temperature, humidity, soilMoisture
  operator        String   @db.VarChar(20) // GT, LT, GTE, LTE, EQ, RANGE
  thresholdMin    Decimal? @map("threshold_min") @db.Decimal(12, 4)
  thresholdMax    Decimal? @map("threshold_max") @db.Decimal(12, 4)
  severity        String   @default("WARNING") @db.VarChar(20) // INFO, WARNING, CRITICAL
  cooldownSeconds Int      @default(300) @map("cooldown_seconds")
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  farm   Farm    @relation(fields: [farmId], references: [id], onDelete: Cascade)
  zone   Zone?   @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  alerts Alert[]

  @@index([farmId, enabled])
  @@map("alert_rules")
}

model Alert {
  id               String    @id @default(uuid()) @db.Uuid
  farmId           String    @map("farm_id") @db.Uuid
  zoneId           String?   @map("zone_id") @db.Uuid
  deviceId         String?   @map("device_id") @db.Uuid
  ruleId           String?   @map("rule_id") @db.Uuid
  metric           String    @db.VarChar(50)
  observedValue    Decimal   @map("observed_value") @db.Decimal(12, 4)
  thresholdValue   Decimal?  @map("threshold_value") @db.Decimal(12, 4)
  severity         String    @db.VarChar(20) // INFO, WARNING, CRITICAL
  status           String    @default("ACTIVE") @db.VarChar(30) // ACTIVE, ACKNOWLEDGED, RESOLVED
  deduplicationKey String    @map("deduplication_key") @db.VarChar(255)
  message          String    @db.Text
  acknowledgedBy   String?   @map("acknowledged_by") @db.Uuid
  acknowledgedAt   DateTime? @map("acknowledged_at") @db.Timestamptz()
  resolvedBy       String?   @map("resolved_by") @db.Uuid
  resolvedAt       DateTime? @map("resolved_at") @db.Timestamptz()
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  farm   Farm       @relation(fields: [farmId], references: [id], onDelete: Cascade)
  zone   Zone?      @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  device Device?    @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  rule   AlertRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@index([farmId, status, createdAt(sort: Desc)])
  @@index([deduplicationKey, status])
  @@map("alerts")
}

model AutomationRule {
  id         String   @id @default(uuid()) @db.Uuid
  farmId     String   @map("farm_id") @db.Uuid
  zoneId     String?  @map("zone_id") @db.Uuid
  name       String   @db.VarChar(100)
  conditions Json     @db.JsonB
  actions    Json     @db.JsonB
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  farm Farm            @relation(fields: [farmId], references: [id], onDelete: Cascade)
  zone Zone?           @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  logs AutomationLog[]

  @@map("automation_rules")
}

model AutomationLog {
  id              String   @id @default(uuid()) @db.Uuid
  ruleId          String   @map("rule_id") @db.Uuid
  executionStatus String   @map("execution_status") @db.VarChar(30) // SUCCESS, FAILED, SKIPPED
  result          Json?    @db.JsonB
  executedAt      DateTime @default(now()) @map("executed_at") @db.Timestamptz()

  rule AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@map("automation_logs")
}

// ==========================================
// 6. DEVICE COMMANDS & CONTROLS
// ==========================================

model DeviceCommand {
  id             String    @id @default(uuid()) @db.Uuid
  deviceId       String    @map("device_id") @db.Uuid
  requestedBy    String    @map("requested_by") @db.Uuid
  commandType    String    @map("command_type") @db.VarChar(50) // PUMP_CONTROL, FAN_CONTROL, VALVE_CONTROL
  idempotencyKey String?   @unique @map("idempotency_key") @db.VarChar(100)
  status         String    @default("ACCEPTED") @db.VarChar(30) // ACCEPTED, PUBLISHED, ACKNOWLEDGED, EXECUTED, FAILED, TIMEOUT
  payload        Json      @db.JsonB
  result         Json?     @db.JsonB
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  device    Device             @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  requester User               @relation("CommandRequester", fields: [requestedBy], references: [id], onDelete: Restrict)
  logs      DeviceCommandLog[]

  @@index([deviceId, createdAt(sort: Desc)])
  @@map("device_commands")
}

model DeviceCommandLog {
  id        String   @id @default(uuid()) @db.Uuid
  commandId String   @map("command_id") @db.Uuid
  eventType String   @map("event_type") @db.VarChar(50)
  payload   Json?    @db.JsonB
  message   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  command DeviceCommand @relation(fields: [commandId], references: [id], onDelete: Cascade)

  @@map("device_command_logs")
}

// ==========================================
// 7. NOTIFICATIONS & OUTBOX EVENTS
// ==========================================

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String    @db.VarChar(50) // ALERT, SYSTEM, COMMAND
  title     String    @db.VarChar(150)
  body      String    @db.Text
  metadata  Json?     @db.JsonB
  readAt    DateTime? @map("read_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@map("notifications")
}

model DeviceToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique @db.VarChar(255)
  platform  String   @db.VarChar(20) // ANDROID, IOS, WEB
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  aggregateType String    @map("aggregate_type") @db.VarChar(100) // Telemetry, Alert, Command...
  aggregateId   String    @map("aggregate_id") @db.VarChar(100)
  eventType     String    @map("event_type") @db.VarChar(100) // TELEMETRY_INGESTED, ALERT_TRIGGERED, COMMAND_REQUESTED
  payload       Json      @db.JsonB
  status        String    @default("PENDING") @db.VarChar(30) // PENDING, PROCESSING, PROCESSED, FAILED
  retryCount    Int       @default(0) @map("retry_count")
  maxRetries    Int       @default(5) @map("max_retries")
  nextRetryAt   DateTime  @default(now()) @map("next_retry_at") @db.Timestamptz()
  lockedAt      DateTime? @map("locked_at") @db.Timestamptz()
  lockedBy      String?   @map("locked_by") @db.VarChar(100)
  processedAt   DateTime? @map("processed_at") @db.Timestamptz()
  lastError     String?   @map("last_error") @db.Text
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@index([status, nextRetryAt])
  @@map("outbox_events")
}

// ==========================================
// 8. AUDIT LOGS
// ==========================================

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(100)
  resource   String   @db.VarChar(100)
  resourceId String?  @map("resource_id") @db.VarChar(100)
  ipAddress  String?  @map("ip_address") @db.VarChar(50)
  userAgent  String?  @map("user_agent") @db.Text
  metadata   Json?    @db.JsonB
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

