# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=*
LOG_LEVEL=debug

# Supabase PostgreSQL Connection
# Direct connection / transaction pooler
DATABASE_URL="postgresql://postgres:your-password@db.your-supabase-ref.supabase.co:5432/postgres?sslmode=require"

# JWT Authentication
JWT_ACCESS_SECRET=smartagri_access_super_secret_key_change_in_production_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=smartagri_refresh_super_secret_key_change_in_production_2026
JWT_REFRESH_EXPIRES_IN=7d

# MQTT Broker (EMQX)
# Test broker: mqtt://broker.emqx.io:1883 or wss://broker.emqx.io:8084/mqtt
MQTT_BROKER_URL=mqtt://broker.emqx.io:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_PREFIX=smartagri_backend

# Worker Polling Intervals (ms)
OUTBOX_POLL_INTERVAL_MS=3000
DEVICE_HEARTBEAT_TIMEOUT_MINUTES=10

